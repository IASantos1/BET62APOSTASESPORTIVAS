# =============================================================
# BET62 APOSTAS ESPORTIVAS — ENVIRONMENT TEMPLATE (RAILWAY)
# =============================================================
# Copiar este ficheiro para .env na RAIZ (e colar em RAILWAY VARIABLES)
# NÃO COMETER ESTE FICHEIRO COM VALORES REAIS NO GIT!
# =============================================================

# ===== DOMÍNIOS PÚBLICOS (definir após Railway gerar URLs) =====
NEXT_PUBLIC_APP_URL="https://bet62-web.up.railway.app"
NEXT_PUBLIC_API_URL="https://bet62-api-gateway.up.railway.app"
APP_URL="https://bet62-web.up.railway.app"
API_URL="https://bet62-api-gateway.up.railway.app"
CORS_ORIGINS="https://bet62-web.up.railway.app,https://bet62-api-gateway.up.railway.app,http://localhost:3080,http://localhost:3000"

# ===== NODE / RUNTIME =====
NODE_ENV="production"
TZ="Europe/Lisbon"

# ===== JWT / SEGURANÇA =====
JWT_SECRET="<<JWT_SECRET_GERAR_ALEATORIO_64_BYTES_NODE_CRYPTO_RANDOMBYTES>>"
JWT_REFRESH_SECRET="<<JWT_REFRESH_SECRET_OUTRA_CHAVE_ALEATORIA_DIFERENTE_DA_ACIMA>>"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS="12"
ENCRYPTION_KEY="<<ENCRYPTION_KEY_32_BYTES_ALEATORIA_PARA_CAMPOS_SENSIVEIS>>"

# ===== RAILWAY POSTGRES (copiar variáveis do serviço Railway Postgres) =====
# Railway gera automaticamente estas quando crias um serviço Postgres.
# Basta copiar "DATABASE_URL" do serviço Postgres para aqui.
DATABASE_URL="<<RAILWAY_POSTGRES_DATABASE_URL_COPIAR_DO_SERVICO_POSTGRES>>"

# Cada serviço usa seu próprio SCHEMA no MESMO Postgres (multiSchema Prisma):
SCHEMA_AUTH_URL="postgresql://postgres:<<RAILWAY_POSTGRES_PASSWORD>>@<<RAILWAY_POSTGRES_HOST>>:<<RAILWAY_POSTGRES_PORT>>/railway?schema=auth"
SCHEMA_USERS_URL="postgresql://postgres:<<RAILWAY_POSTGRES_PASSWORD>>@<<RAILWAY_POSTGRES_HOST>>:<<RAILWAY_POSTGRES_PORT>>/railway?schema=users"
SCHEMA_KYC_URL="postgresql://postgres:<<RAILWAY_POSTGRES_PASSWORD>>@<<RAILWAY_POSTGRES_HOST>>:<<RAILWAY_POSTGRES_PORT>>/railway?schema=kyc"
SCHEMA_WALLET_URL="postgresql://postgres:<<RAILWAY_POSTGRES_PASSWORD>>@<<RAILWAY_POSTGRES_HOST>>:<<RAILWAY_POSTGRES_PORT>>/railway?schema=wallet"
SCHEMA_ODDS_URL="postgresql://postgres:<<RAILWAY_POSTGRES_PASSWORD>>@<<RAILWAY_POSTGRES_HOST>>:<<RAILWAY_POSTGRES_PORT>>/railway?schema=odds"
SCHEMA_BETS_URL="postgresql://postgres:<<RAILWAY_POSTGRES_PASSWORD>>@<<RAILWAY_POSTGRES_HOST>>:<<RAILWAY_POSTGRES_PORT>>/railway?schema=bets"
SCHEMA_BONUS_URL="postgresql://postgres:<<RAILWAY_POSTGRES_PASSWORD>>@<<RAILWAY_POSTGRES_HOST>>:<<RAILWAY_POSTGRES_PORT>>/railway?schema=bonus"
SCHEMA_CASINO_URL="postgresql://postgres:<<RAILWAY_POSTGRES_PASSWORD>>@<<RAILWAY_POSTGRES_HOST>>:<<RAILWAY_POSTGRES_PORT>>/railway?schema=casino"
SCHEMA_NOTIFS_URL="postgresql://postgres:<<RAILWAY_POSTGRES_PASSWORD>>@<<RAILWAY_POSTGRES_HOST>>:<<RAILWAY_POSTGRES_PORT>>/railway?schema=notifications"
SCHEMA_ADMIN_URL="postgresql://postgres:<<RAILWAY_POSTGRES_PASSWORD>>@<<RAILWAY_POSTGRES_HOST>>:<<RAILWAY_POSTGRES_PORT>>/railway?schema=admins"

# ===== RAILWAY REDIS (copiar variáveis do serviço Railway Redis) =====
# Quando crias o serviço Redis no Railway, copia "REDIS_URL" daqui:
REDIS_URL="<<RAILWAY_REDIS_URL_COMPLETO_COPIAR_DO_SERVICO_REDIS>>"
REDIS_HOST="<<RAILWAY_REDIS_HOST_EXEMPLO_autorack.proxy.rlwy.net>>"
REDIS_PORT="<<RAILWAY_REDIS_PORT_EXEMPLO_17529>>"
REDIS_PASSWORD="<<RAILWAY_REDIS_PASSWORD_COPIAR_DO_SERVICO>>"
REDIS_DB="0"

# ===== KYC - SUMSUB (https://cockpit.sumsub.com) =====
SUMSUB_ENVIRONMENT="sandbox"
SUMSUB_BASE_URL="https://api.sumsub.com"
SUMSUB_APP_TOKEN="<<SUMSUB_APP_TOKEN_DO_COCKPIT_SUM_SUB>>"
SUMSUB_SECRET_KEY="<<SUMSUB_SECRET_KEY_DO_COCKPIT_SUM_SUB>>"
SUMSUB_WEBHOOK_SECRET="<<SUMSUB_WEBHOOK_SECRET_CRIAR_NO_COCKPIT>>"
SUMSUB_LEVEL_NAME_L0="basic-kyc-level"
SUMSUB_LEVEL_NAME_L1="standard-kyc-level"
SUMSUB_LEVEL_NAME_L2="full-kyc-level"

# ===== PAGAMENTOS - STRIPE (https://dashboard.stripe.com) =====
STRIPE_ENVIRONMENT="test"
STRIPE_SECRET_KEY="<<STRIPE_SECRET_KEY_DEVELOPERS_DASHBOARD>>"
STRIPE_PUBLISHABLE_KEY="<<STRIPE_PUBLISHABLE_KEY_DEVELOPERS_DASHBOARD>>"
STRIPE_WEBHOOK_SECRET="<<STRIPE_WEBHOOK_SECRET_CRIAR_EM_WEBHOOKS>>"
STRIPE_CURRENCY="eur"
STRIPE_MIN_DEPOSIT="10"
STRIPE_MAX_DEPOSIT="5000"
STRIPE_MIN_WITHDRAWAL="20"
STRIPE_MAX_WITHDRAWAL="15000"
STRIPE_ACCOUNT_COUNTRY="PT"

# ===== ODDS PROVIDER (a definir: OddsJam / OddsAPI / B365 / etc) =====
ODDS_PROVIDER_NAME="CUSTOM_PROVIDER"
ODDS_PROVIDER_BASE_URL="https://api.tu-provider-aqui.com/v2"
ODDS_PROVIDER_API_KEY="<<COLOCA_AQUI_A_CHAVE_DO_TEU_PROVIDER_DE_ODDS>>"
ODDS_CACHE_TTL_SECONDS="30"
ODDS_LIVE_REFRESH_MS="5000"

# ===== SMTP EMAIL (ex: Resend / Postmark / Sendgrid / SMTP normal) =====
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="<<CHAVE_SMTP_DO_TEU_PROVEDOR_EMAIL_RESEND_OU_OUTRO>>"
SMTP_FROM="BET62 Apostas <noreply@bet62apostas.pt>"
SMTP_SECURE="false"

# ===== PUSH VAPID (PWA) =====
# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="<<VAPID_PUBLIC_KEY_GERAR_COM_NPX_WEB_PUSH_GENERATE_VAPID_KEYS>>"
VAPID_PRIVATE_KEY="<<VAPID_PRIVATE_KEY_GERAR_COM_NPX_WEB_PUSH_GENERATE_VAPID_KEYS>>"
VAPID_SUBJECT="mailto:admin@bet62apostas.pt"

# ===== ADMIN DEFAULT (1º SUPER ADMIN) =====
ADMIN_DEFAULT_EMAIL="admin@bet62apostas.pt"
ADMIN_DEFAULT_PASSWORD="<<DEFINE_AQUI_PASSWORD_FORTISSIMA_SUPER_ADMIN>>"
ADMIN_DEFAULT_FIRST_NAME="Administrador"
ADMIN_DEFAULT_LAST_NAME="BET62"

# ===== REGULAMENTAÇÃO MGA MALTA =====
REGULATOR_NAME="MGA - Malta Gaming Authority"
REGULATOR_LICENSE_NUMBER="MGA/B2C/XXX/2024"
RESPONSIBLE_GAMBLING_ALLOW_LIMITS="true"
RESPONSIBLE_GAMBLING_ALLOW_SELF_EXCLUSION="true"
MIN_BET_AMOUNT="0.50"
MAX_BET_AMOUNT="2000"
MAX_PAYOUT_SINGLE_BET="250000"

# ===== API GATEWAY PORT =====
PORT="3000"
AUTH_SERVICE_URL="http://bet62-auth-service:3001"
USER_SERVICE_URL="http://bet62-user-service:3002"
KYC_SERVICE_URL="http://bet62-kyc-service:3003"
WALLET_SERVICE_URL="http://bet62-wallet-service:3004"
ODDS_SERVICE_URL="http://bet62-odds-service:3005"
BETS_SERVICE_URL="http://bet62-bets-service:3006"
BONUS_SERVICE_URL="http://bet62-bonus-service:3007"
CASINO_SERVICE_URL="http://bet62-casino-service:3008"
NOTIFICATIONS_SERVICE_URL="http://bet62-notifications-service:3009"
ADMIN_SERVICE_URL="http://bet62-admin-service:3010"

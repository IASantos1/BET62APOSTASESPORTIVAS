# pnpm: hoisting classico (equivalente ao node_modules flat do npm/yarn), necessario
# porque os servicos NestJS resolvem peer packages (class-validator, etc.) relativos
# ao node_modules raiz onde @nestjs/core fica hoisted.
shamefully-hoist=true
public-hoist-pattern[]=*

# Pacotes internos (@bet62/shared etc.) sao declarados com ranges semver comuns
# ("*", "^1.0.0"), nao com o protocolo "workspace:". Sem isso, pnpm tenta buscar
# esses pacotes no registry publico do npm e falha (404).
link-workspace-packages=true

# Garante que as devDependencies sejam sempre instaladas, independente de NODE_ENV.
auto-install-peers=true
strict-peer-dependencies=false

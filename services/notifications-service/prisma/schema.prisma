generator client {
  provider        = "prisma-client-js"
  output          = "../src/prisma/generated/client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["notifications"]
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH_WEB
  PUSH_FCM
  PUSH_APNS
  WHATSAPP
  TELEGRAM
  @@schema("notifications")
}

enum NotificationCategory {
  GENERAL
  BET_PLACED
  BET_WON
  BET_LOST
  BET_SETTLED
  CASHOUT_COMPLETED
  DEPOSIT_PENDING
  DEPOSIT_COMPLETED
  DEPOSIT_FAILED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_REJECTED
  KYC_STATUS_CHANGED
  KYC_REVIEW_REQUESTED
  BONUS_GRANTED
  BONUS_EXPIRING
  BONUS_ROLLOVER_COMPLETE
  PROMOTIONAL
  CASINO_BIG_WIN
  LIVE_EVENT_STARTED
  FAVORITE_TEAM_SCORED
  SECURITY_LOGIN
  SECURITY_PASSWORD_CHANGED
  SECURITY_2FA_CHANGED
  SUPPORT_REPLY
  RESPONSIBLE_GAMING_ALERT
  SYSTEM_MAINTENANCE
  @@schema("notifications")
}

enum NotificationPreferenceScope {
  GLOBAL
  CATEGORY
  CHANNEL
  EVENT
  @@schema("notifications")
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  EXPIRED
  CANCELLED
  SUPPRESSED
  OPTED_OUT
  @@schema("notifications")
}

model NotificationTemplate {
  id                    String                      @id @default(uuid())
  name                  String
  category              NotificationCategory        @default(GENERAL)
  locale                String                      @default("pt-PT") @db.VarChar(16)
  channel               NotificationChannel
  subject               String?
  titleTemplate         String?
  bodyTemplate          String?                     @db.Text
  htmlTemplate          String?                     @db.Text
  variablesDescription  Json?
  isActive              Boolean                     @default(true)
  priority              Int                         @default(5)
  createdBy             String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  deletedAt             DateTime?

  @@unique([name, locale, channel])
  @@index([channel, isActive])
  @@index([category, isActive])
  @@schema("notifications")
  @@map("notification_template")
}

model Notification {
  id                String                  @id @default(uuid())
  userId            String?
  correlationId     String?
  providerMessageId String?
  channel           NotificationChannel
  category          NotificationCategory  @default(GENERAL)
  title             String
  body              String                  @db.Text
  htmlBody          String?                 @db.Text
  imageUrl          String?
  deepLink          String?
  payload           Json?
  status            NotificationStatus    @default(PENDING)
  attempts          Int                   @default(0)
  lastAttemptAt     DateTime?
  lastError         String?                 @db.Text
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  suppressedReason  String?
  language          String?                 @db.VarChar(16)
  timezone          String?                 @db.VarChar(64)
  priority          Int?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt DateTime? @db.Timestamptz

  @@index([userId, status, createdAt])
  @@index([channel, status])
  @@index([correlationId])
  @@schema("notifications")
  @@map("notification")
}

model DeviceToken {
  id                  String    @id @default(uuid())
  userId              String
  token               String    @unique
  platform            String    @db.VarChar(32)
  deviceId            String?
  deviceModel         String?
  osVersion           String?
  appVersion          String?
  locale              String?   @db.VarChar(16)
  enabledNotifications Boolean   @default(true)
  isSandbox           Boolean   @default(false)
  lastUsedAt          DateTime?
  subscribedAt        DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, enabledNotifications])
  @@index([platform, enabledNotifications])
  @@schema("notifications")
  @@map("device_token")
}

model NotificationPreference {
  id        String                       @id @default(uuid())
  userId    String
  scope     NotificationPreferenceScope  @default(GLOBAL)
  category  NotificationCategory?
  channel   NotificationChannel?
  eventKey  String?
  enabled   Boolean                      @default(true)
  updatedAt DateTime                     @updatedAt
  createdAt DateTime                     @default(now())

  @@unique([userId, scope, category, channel, eventKey])
  @@index([userId])
  @@schema("notifications")
  @@map("notification_preference")
}

model EmailQueue {
  id              String              @id @default(uuid())
  toEmail         String
  fromName        String?
  replyTo         String?
  subject         String
  textBody        String?             @db.Text
  htmlBody        String?             @db.Text
  templateVars    Json?
  attachmentUrls  String[]            @default([])
  status          NotificationStatus  @default(PENDING)
  attempts        Int                 @default(0)
  lastError       String?             @db.Text
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime            @default(now())

  @@index([status, scheduledAt])
  @@index([toEmail, createdAt])
  @@schema("notifications")
  @@map("email_queue")
}

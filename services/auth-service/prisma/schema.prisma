generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE

  @@map("auth_provider")
  @@schema("auth")
}

enum TwoFactorType {
  NONE
  TOTP
  SMS
  EMAIL

  @@map("two_factor_type")
  @@schema("auth")
}

model AuthUser {
  userId                  String           @id @default(uuid())
  email                   String           @unique
  passwordHash            String
  emailVerifiedAt         DateTime?
  provider                AuthProvider     @default(EMAIL)
  roles                   String[]         @default(["USER"])
  twoFactorType           TwoFactorType    @default(NONE)
  twoFactorSecret         String?
  twoFactorRecoveryCodes  String[]
  isActive                Boolean          @default(true)
  lastLoginAt             DateTime?
  lastLoginIp             String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  deletedAt               DateTime?

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogLogins          AuditLogLogin[]

  @@index([email])
  @@index([isActive])
  @@index([provider])
  @@index([deletedAt])
  @@schema("auth")
  @@map("auth_user")
}

model RefreshToken {
  id            String     @id @default(uuid())
  userId        String
  tokenHash     String
  ipAddress     String?
  userAgent     String?
  location      Json?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          AuthUser   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId])
  @@index([tokenHash])
  @@index([isActive])
  @@index([expiresAt])
  @@index([revokedAt])
  @@schema("auth")
  @@map("refresh_token")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  isUsed    Boolean  @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      AuthUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([tokenHash])
  @@index([isUsed])
  @@index([expiresAt])
  @@schema("auth")
  @@map("password_reset_token")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  isUsed    Boolean  @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      AuthUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([tokenHash])
  @@index([isUsed])
  @@index([expiresAt])
  @@schema("auth")
  @@map("email_verification_token")
}

model AuditLogLogin {
  id            String    @id @default(uuid())
  userId        String?
  email         String
  success       Boolean
  ipAddress     String?
  userAgent     String?
  attemptAt     DateTime  @default(now())
  failureReason String?

  user          AuthUser? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([email])
  @@index([userId])
  @@index([success])
  @@index([attemptAt])
  @@schema("auth")
  @@map("audit_log_login")
}

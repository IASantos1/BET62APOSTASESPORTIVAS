generator client {
  provider        = "prisma-client-js"
  output          = "../src/prisma/generated/client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["users"]
}

enum CountryCode {
  PT
  ES
  FR
  DE
  IT
  NL
  MT
  GB
  BR
  OTHER

  @@schema("users")
}

enum LanguageCode {
  pt_PT
  en_US
  es_ES

  @@schema("users")
}

enum CurrencyCode {
  EUR
  USD
  GBP
  BRL

  @@schema("users")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  SELF_EXCLUDED
  BANNED
  CLOSED

  @@schema("users")
}

enum SelfExcludeDuration {
  DAYS_7
  DAYS_30
  DAYS_90
  DAYS_180
  DAYS_365
  PERMANENT

  @@schema("users")
}

enum OddsFormat {
  decimal
  fractional
  american
  hongkong
  indonesian
  malay

  @@schema("users")
}

model UserProfile {
  userId             String       @id @db.Uuid
  firstName          String?
  lastName           String?
  fullName           String?
  dateOfBirth        DateTime?
  gender             String?
  country            CountryCode  @default(PT)
  phoneNumber        String?
  phoneVerifiedAt    DateTime?
  city               String?
  address            String?
  postalCode         String?
  preferredLanguage  LanguageCode @default(pt_PT)
  preferredCurrency  CurrencyCode @default(EUR)
  timezone           String?
  marketingOptIn     Boolean      @default(false)
  smsOptIn           Boolean      @default(false)
  pushOptIn          Boolean      @default(false)
  status             UserStatus   @default(ACTIVE)
  registeredFromIp   String?
  registeredLocation Json?
  affiliateCode      String?
  vipLevel           Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  preferences          UserPreferences?
  limits               UserLimits?
  selfExclusionRecords SelfExclusionRecord[]
  realityCheckLogs     RealityCheckLog[]

  @@schema("users")
}

model UserPreferences {
  userId                    String     @id @db.Uuid
  oddsFormat                OddsFormat @default(decimal)
  defaultStake              Float?
  betAcceptanceType         String     @default("ACCEPT_EQUAL_OR_HIGHER")
  showLiveScores            Boolean    @default(true)
  showFavoritesOnly         Boolean    @default(false)
  darkMode                  Boolean    @default(true)
  autoCashoutEnabled        Boolean    @default(false)
  autoCashoutThreshold      Float?
  realityCheckEnabled       Boolean    @default(true)
  realityCheckIntervalMin   Int        @default(60)
  quickBetEnabled           Boolean    @default(false)
  soundEnabled              Boolean    @default(true)
  notificationSoundsEnabled Boolean    @default(true)
  favoriteSports            String[]   @default([])
  favoriteLeagues           String[]   @default([])
  favoriteTeams             String[]   @default([])
  deletedAt                 DateTime?  @db.Timestamptz

  profile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@schema("users")
}

model UserLimits {
  userId                 String    @id @db.Uuid
  depositDailyLimit      Float?
  depositWeeklyLimit     Float?
  depositMonthlyLimit    Float?
  wagerDailyLimit        Float?
  wagerWeeklyLimit       Float?
  wagerMonthlyLimit      Float?
  lossDailyLimit         Float?
  lossWeeklyLimit        Float?
  lossMonthlyLimit       Float?
  sessionTimeLimitMin    Int?
  stakePerBetMax         Float?
  stakePerBetMin         Float     @default(0.1)
  withdrawalDailyLimit   Float?
  withdrawalMonthlyLimit Float?
  kycLevelApplied        Int       @default(0)
  deletedAt              DateTime? @db.Timestamptz

  profile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@schema("users")
}

model SelfExclusionRecord {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  duration  SelfExcludeDuration
  startedAt DateTime            @default(now())
  endsAt    DateTime?
  reason    String?
  revokedAt DateTime?
  revokedBy String?
  isActive  Boolean             @default(true)

  profile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@schema("users")
}

model RealityCheckLog {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  sessionId            String
  sessionStartAt       DateTime
  checkAt              DateTime  @default(now())
  acknowledgedAt       DateTime?
  continuePlay         Boolean?
  wageredDuringSession Float     @default(0)
  won                  Float     @default(0)
  lost                 Float     @default(0)
  net                  Float     @default(0)

  profile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@schema("users")
}

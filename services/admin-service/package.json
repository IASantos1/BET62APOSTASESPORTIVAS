{
  "name": "@bet62/admin-service",
  "version": "1.0.0",
  "description": "BET62 Admin Microservice",
  "private": true,
  "scripts": {
    "build": "nest build",
    "postbuild": "node -e \"try{const fs=require('fs');const p=require('path');const s=p.join(__dirname,'src','prisma','generated');const d=p.join(__dirname,'dist','prisma','generated');fs.existsSync(s)&&fs.cpSync(s,d,{recursive:true,force:true});console.log('[postbuild] prisma/generated copiado para dist/prisma/generated')}catch(e){console.warn('[postbuild] skip copy prisma:', e.message)}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@bet62/shared": "*",
    "@nestjs/bullmq": "^10.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.1.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.31.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "otplib": "^12.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/express-session": "^1.17.0",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/qrcode": "^1.5.0",
    "prisma": "^5.22.0",
    "typescript": "^5.3.3"
  }
}

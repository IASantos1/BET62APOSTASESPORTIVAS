generator client {
  provider        = "prisma-client-js"
  output          = "../src/prisma/generated/client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["casino"]
}

enum CasinoGameCategory {
  SLOTS
  ROULETTE
  BLACKJACK
  BACCARAT
  POKER
  CRAPS
  KENO
  SCRATCH_CARDS
  BINGO
  LIVE_DEALER
  LIVE_ROULETTE
  LIVE_BLACKJACK
  LIVE_BACCARAT
  GAME_SHOW
  VIRTUAL_SPORTS
  JACKPOT
  MEGA_WAYS
  @@schema("casino")
}

enum CasinoGameStatus {
  ACTIVE
  MAINTENANCE
  DISABLED
  COMING_SOON
  @@schema("casino")
}

enum CasinoBetStatus {
  PLACED
  WON
  LOST
  PUSH
  VOID
  FREE_SPIN
  BONUS_GAME
  @@schema("casino")
}

enum CasinoProvider {
  MOCK
  BIGBANG
  PGSOFT
  EVOLUTION
  PRAGMATIC
  NETENT
  MICROGAMING
  PLAYTECH
  YGGDRASIL
  QUICKSPIN
  RED_TIGER
  PLAY_N_GO
  HABANERO
  BOOMING
  @@schema("casino")
}

enum CasinoSessionStatus {
  INITIATED
  ACTIVE
  CLOSED
  TIMED_OUT
  ERROR
  KYC_REQUIRED
  SELF_EXCLUDED
  @@schema("casino")
}

enum CasinoJackpotType {
  PROGRESSIVE
  LOCAL
  NETWORK
  DAILY_DROP
  @@schema("casino")
}

model CasinoGame {
  id                     String              @id @default(uuid())
  providerId             String
  providerGameId         String
  name                   String
  slug                   String              @unique
  category               CasinoGameCategory
  provider               CasinoProvider
  status                 CasinoGameStatus    @default(ACTIVE)
  rtp                    Decimal             @db.Decimal(5, 2)
  volatility             String?             @db.VarChar(16)
  minBet                 Decimal             @default(0.10) @db.Decimal(12, 2)
  maxBet                 Decimal             @default(5000) @db.Decimal(12, 2)
  maxWinMultiplier       Decimal?            @db.Decimal(10, 2)
  lines                  Int?
  reels                  Int?
  hasFreeSpins           Boolean             @default(false)
  hasJackpot             Boolean             @default(false)
  hasBonusBuy            Boolean             @default(false)
  hasLiveDealer          Boolean             @default(false)
  gameConfig             Json?
  thumbUrl               String?
  bannerUrl              String?
  lobbyTags              String[]            @default([])
  languages              String[]            @default([])
  countriesBlocked       String[]            @default([])
  isNew                  Boolean             @default(false)
  isHot                  Boolean             @default(false)
  isFeatured             Boolean             @default(false)
  popularTrendScore      Int?
  totalRoundsPlayed      BigInt              @default(0)
  totalWagered           Decimal             @default(0) @db.Decimal(18, 2)
  totalPayout            Decimal             @default(0) @db.Decimal(18, 2)
  lastWinAt              DateTime?
  seededHouseEdgePercent Decimal?            @db.Decimal(5, 4)
  providerUrlDeepLink    String?
  createdBy              String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?

  favorites              CasinoGameFavorite[]
  sessions               CasinoSession[]
  bets                   CasinoBet[]
  providerWalletTxs      CasinoProviderWalletTx[]

  @@unique([providerId, providerGameId])
  @@index([category, status])
  @@index([provider, status])
  @@index([isFeatured, status])
  @@index([isHot, status])
  @@index([isNew, status])
  @@index([slug])
  @@schema("casino")
  @@map("casino_game")
}

model CasinoGameFavorite {
  id           String     @id @default(uuid())
  userId       String
  gameId       String
  favoritedAt  DateTime   @default(now())

  game         CasinoGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@schema("casino")
  @@map("casino_game_favorite")
}

model CasinoSession {
  id                      String              @id @default(uuid())
  userId                  String
  gameId                  String
  playerToken             String?             @unique
  sessionStatus           CasinoSessionStatus @default(INITIATED)
  providerSessionReference String?
  walletId                String?
  currency                String              @default("EUR") @db.VarChar(8)
  startedAt               DateTime            @default(now())
  endedAt                 DateTime?
  totalRounds             Int                 @default(0)
  totalWagered            Decimal             @default(0) @db.Decimal(14, 2)
  totalPayout             Decimal             @default(0) @db.Decimal(14, 2)
  maxWinDuringSession     Decimal?            @db.Decimal(14, 2)
  ipAddress               String?
  device                  String?
  userAgent               String?
  geoCountry              String?
  closedReason            String?
  closedBy                String?
  correlationId           String?
  playerBalanceSnapshots  Json?

  game                    CasinoGame          @relation(fields: [gameId], references: [id])
  bets                    CasinoBet[]

  @@index([userId, sessionStatus])
  @@index([userId, endedAt])
  @@index([gameId, sessionStatus])
  @@schema("casino")
  @@map("casino_session")
}

model CasinoBet {
  id                      String              @id @default(uuid())
  userId                  String
  sessionId               String?
  gameId                  String
  providerRef             String?             @unique
  roundRef                String?
  status                  CasinoBetStatus     @default(PLACED)
  wageredAmount           Decimal             @db.Decimal(14, 2)
  wageredCurrency         String              @default("EUR") @db.VarChar(8)
  linesBet                Int?
  stakePerLine            Decimal?            @db.Decimal(12, 4)
  payoutAmount            Decimal?            @db.Decimal(14, 2)
  netResult               Decimal?            @db.Decimal(14, 2)
  betType                 String?
  jackpotContribution     Decimal?            @db.Decimal(14, 4)
  jackpotWin              Decimal?            @db.Decimal(16, 2)
  placedAt                DateTime            @default(now())
  settledAt               DateTime?
  settledBy               String?
  initialSeed             String?
  resultSeed              String?
  finalRevealSnapshot     Json?
  resultSymbols           Json?
  winningLines            Json?
  freeSpinsTriggered      Int?
  bonusRoundTriggered     Boolean?            @default(false)
  gambleFeatureUsed       Boolean?            @default(false)
  gambleResult            String?
  correlationId           String?
  providerRawRequest      Json?
  providerRawResponse     Json?
  deletedAt DateTime? @db.Timestamptz

  session                 CasinoSession?      @relation(fields: [sessionId], references: [id])
  game                    CasinoGame          @relation(fields: [gameId], references: [id])

  @@index([userId, status])
  @@index([userId, placedAt])
  @@index([sessionId])
  @@index([gameId, status])
  @@index([roundRef])
  @@schema("casino")
  @@map("casino_bet")
}

model CasinoProviderWalletTx {
  id                 String      @id @default(uuid())
  provider           CasinoProvider
  transactionId      String      @unique
  roundId            String?
  type               String
  roundEnd           Boolean     @default(false)
  username           String
  amount             Decimal     @db.Decimal(14, 2)
  currency           String      @default("EUR") @db.VarChar(8)
  gameId             String?
  externalBetRef     String?
  providerCategoryId String?
  status             String      @default("PENDING")
  sandbox            Boolean     @default(false)
  balanceAfter       Decimal?    @db.Decimal(14, 2)
  requestPayload     Json?
  responsePayload    Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  game               CasinoGame? @relation(fields: [gameId], references: [id])
  @@index([username, roundId])
  @@index([provider, status])
  @@schema("casino")
  @@map("casino_provider_wallet_tx")
}

model CasinoJackpot {
  id                         String              @id @default(uuid())
  type                       CasinoJackpotType
  name                       String
  currency                   String              @default("EUR") @db.VarChar(8)
  currentAmount              Decimal             @db.Decimal(16, 2)
  seedAmount                 Decimal             @db.Decimal(16, 2)
  maxCapAmount               Decimal?            @db.Decimal(16, 2)
  contributionPercentOfBet   Decimal             @default(0.02) @db.Decimal(5, 4)
  triggerAmount              Decimal?            @db.Decimal(16, 2)
  lastWinAt                  DateTime?
  lastWinAmount              Decimal?            @db.Decimal(16, 2)
  lastWinnerId               String?
  triggerChancePerMillion    Int?
  enabled                    Boolean             @default(true)
  gameIds                    String[]            @default([])
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  @@index([type, enabled])
  @@index([enabled])
  @@schema("casino")
  @@map("casino_jackpot")
}

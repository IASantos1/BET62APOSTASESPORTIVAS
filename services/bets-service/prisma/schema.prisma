generator client {
  provider        = "prisma-client-js"
  output          = "../src/prisma/generated/client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["bets"]
}

enum BetType {
  SINGLE
  MULTIPLE
  SYSTEM
  CHAIN
  @@schema("bets")
}

enum BetStatus {
  PENDING
  PLACED
  LIVE
  WON
  LOST
  HALF_WON
  HALF_LOST
  VOID
  CASHOUT
  CASHOUT_PARTIAL
  REJECTED
  CANCELLED
  UNDER_REVIEW
  @@schema("bets")
}

enum BetAcceptanceType {
  ACCEPT_HIGHER_ODDS
  ACCEPT_ANY_ODDS
  ACCEPT_NO_CHANGE
  ACCEPT_EQUAL_OR_HIGHER
  @@schema("bets")
}

enum CashoutType {
  FULL
  PARTIAL
  AUTO
  @@schema("bets")
}

enum SystemBetType {
  T_2_OF_3
  T_2_OF_4
  T_3_OF_4
  T_2_OF_5
  T_3_OF_5
  T_4_OF_5
  T_2_OF_6
  T_3_OF_6
  T_4_OF_6
  T_5_OF_6
  @@schema("bets")
}

enum SelectionOutcome {
  HOME
  DRAW
  AWAY
  OVER
  UNDER
  YES
  NO
  WON
  LOST
  VOID
  PENDING
  HALF_WON
  HALF_LOST
  @@schema("bets")
}

enum MarketType {
  MATCH_WINNER_1X2
  MATCH_WINNER_12
  OVER_UNDER_TOTAL
  OVER_UNDER_HOME
  OVER_UNDER_AWAY
  BTTS_YES_NO
  CORRECT_SCORE
  HALF_TIME_RESULT
  HALF_TIME_FULL_TIME
  DOUBLE_CHANCE
  ASIAN_HANDICAP
  EUROPEAN_HANDICAP
  FIRST_GOAL_SCORER
  ANYTIME_GOAL_SCORER
  EXACT_GOALS
  MATCH_RESULT_BOTH_TEAMS_TO_SCORE
  DRAW_NO_BET
  TOTAL_CORNERS
  TOTAL_CARDS
  NEXT_GOAL
  WINNING_MARGIN
  SET_WINNER
  GAME_WINNER
  TIE_NO_BET
  TOTAL_POINTS
  MONEYLINE
  SPREAD
  TOTAL
  @@schema("bets")
}

enum MarketStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  SETTLED
  @@schema("bets")
}

enum CashoutStatus {
  REQUESTED
  PROCESSING
  CONFIRMED
  FAILED
  REJECTED
  @@schema("bets")
}

model Bet {
  id                           String             @id @default(uuid())
  userId                       String
  walletId                     String
  transactionId                String?
  externalId                   String?
  betNumber                    String?            @unique
  betType                      BetType
  systemType                   SystemBetType?
  status                       BetStatus          @default(PENDING)
  selectionsCount              Int
  winningSelectionsCount       Int?
  stakeAmount                  Decimal
  stakeRealUsed                Decimal      @default(0)
  stakeBonusUsed               Decimal      @default(0)
  stakeFreebetUsed             Decimal      @default(0)
  totalOdds                    Decimal
  oddsMultiplier               Decimal?
  potentialReturn              Decimal
  potentialWin                 Decimal
  maxWinCap                    Decimal?
  bonusIdUsed                  String?
  freebetIdUsed                String?
  acceptanceType               BetAcceptanceType
  acceptedOddsChangeMaxPercent Decimal?
  actualOddsChangePercent      Decimal?
  cashoutAvailable             Boolean            @default(true)
  cashoutValueCurrent          Decimal?
  cashoutValueMin              Decimal?
  cashoutValueMax              Decimal?
  cashoutEnabled               Boolean            @default(true)
  autoCashoutValue             Decimal?
  autoCashoutTriggered         Boolean?
  autoCashoutAt                DateTime?
  partialCashoutRemainingStake Decimal?
  partialCashoutTotalCashedOut Decimal?
  placedAt                     DateTime
  placedIp                     String?
  placedDevice                 String?
  placedLanguage               String?
  settledAt                    DateTime?
  settledBy                    String?
  settlementSource             String?
  settlementNote               String?
  actualReturn                 Decimal?
  actualWinNet                 Decimal?
  actualTaxDeducted            Decimal?
  oddsBoostAppliedId           String?
  combiBoostPercent            Decimal?
  accumulatorBonusPercent      Decimal?
  riskFlagged                  Boolean            @default(false)
  riskFlags                    String[]           @default([])
  riskReviewed                 Boolean?
  riskReviewedAt               DateTime?
  riskReviewedBy               String?
  cancelledReason              String?
  cancelledAt                  DateTime?
  cancelledBy                  String?
  correlationId                String?
  expiresAt                    DateTime?
  metadata                     Json?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  deletedAt                    DateTime?

  selections                   BetSelection[]
  cashoutRecords               CashoutRecord[]
  settlementLogs               BetSettlementLog[]

  @@index([userId])
  @@index([status])
  @@index([walletId])
  @@index([placedAt])
  @@index([betNumber])
  @@index([betType])
  @@index([userId, status, placedAt])
  @@index([userId, betType])
  @@schema("bets")
  @@map("bet")
}

model BetSelection {
  id                    String           @id @default(uuid())
  betId                 String
  eventId               String
  marketId              String
  selectionId           String
  selectionName         String
  marketName            String
  eventName             String
  homeTeamName          String?
  awayTeamName          String?
  leagueName            String?
  sportType             String?
  kickoffAt             DateTime
  marketType            MarketType
  outcome               SelectionOutcome
  specifiers            Json?
  oddsAtPlacement       Decimal
  oddsDisplayAtPlacement String?
  handicapValue         Decimal?
  totalLineValue        Decimal?
  status                SelectionOutcome @default(PENDING)
  settledAt             DateTime?
  settledOdds           Decimal?
  resultScore           Json?
  providerEventId       String?
  providerMarketId      String?
  providerSelectionId   String?
  orderIndex            Int
  deletedAt DateTime? @db.Timestamptz

  bet                   Bet              @relation(fields: [betId], references: [id], onDelete: Cascade)

  @@unique([betId, orderIndex])
  @@index([eventId])
  @@index([betId, status])
  @@index([selectionId])
  @@schema("bets")
  @@map("bet_selection")
}

model CashoutRecord {
  id                         String         @id @default(uuid())
  betId                      String
  userId                     String
  walletId                   String
  transactionId              String?
  cashoutType                CashoutType
  status                     CashoutStatus  @default(REQUESTED)
  stakeBefore                Decimal
  stakeAfter                 Decimal?
  stakeCashedOut             Decimal?
  amountRequested            Decimal
  amountFee                  Decimal  @default(0)
  amountNetToUser            Decimal
  oddsAtCashout              Decimal?
  probabilityImpliedAtCashout Decimal?
  houseEdgePercentApplied    Decimal   @default(0)
  confirmedAt                DateTime?
  failedReason               String?
  failedAt                   DateTime?
  rejectedReason             String?
  rejectedAt                 DateTime?
  cashoutSnapshot            Json?
  correlationId              String?
  requestIp                  String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  bet                        Bet            @relation(fields: [betId], references: [id], onDelete: Cascade)

  @@index([betId])
  @@index([userId])
  @@index([walletId])
  @@index([status, createdAt])
  @@schema("bets")
  @@map("cashout_record")
}

model BetSettlementLog {
  id                String   @id @default(uuid())
  betId             String
  statusBefore      BetStatus
  statusAfter       BetStatus
  settlementSource  String
  settledBy         String?
  actualReturnBefore Decimal?
  actualReturnAfter  Decimal?
  selectionsResults Json?
  reason            String?
  note              String?
  correlationId     String?
  createdAt         DateTime @default(now())

  bet               Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)

  @@index([betId])
  @@index([settlementSource, createdAt])
  @@schema("bets")
  @@map("bet_settlement_log")
}

model BetSlipDraft {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  userId          String?
  selections      Json     @default("[]")
  stakeAmount     Decimal?
  stakeBonusUsed  Decimal?
  acceptanceType  String?
  cashoutEnabled  Boolean?
  promocode       String?
  bonusIdUsed     String?
  freebetIdUsed   String?
  expiresAt       DateTime?
  updatedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@schema("bets")
  @@map("bet_slip_draft")
}

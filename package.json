{
  "name": "bet62-platform",
  "private": true,
  "version": "1.0.0",
  "description": "BET62 - Frontend (estrutura, layout e páginas)",
  "scripts": {
    "build": "pnpm --filter @bet62/web run build",
    "start": "pnpm --filter @bet62/web run start",
    "dev": "pnpm --filter @bet62/web run dev",
    "lint": "pnpm --filter @bet62/web run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "@types/minimatch": "5.1.2"
    }
  }
}

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run prisma:generate:all && npm run build",
    "buildEnvironmentVariables": {
      "NODE_ENV": "development",
      "NPM_CONFIG_PRODUCTION": "false"
    },
    "nixpacksPlan": {
      "phases": {
        "install": {
          "cmds": ["npm ci --include=dev --ignore-scripts=false --foreground-scripts"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "npm run prisma:migrate:deploy:all && npm run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

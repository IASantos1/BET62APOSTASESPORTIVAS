# ========================================================
# BET62 APOSTAS ESPORTIVAS - ENVIRONMENT EXAMPLE
# ========================================================
# Copiar para .env e preencher valores reais
# ========================================================

# ============ NODE ============
NODE_ENV=development
TZ=Europe/Lisbon

# ============ POSTGRESQL ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bet62
POSTGRES_PASSWORD=Bet62!StrongPass2026
POSTGRES_DB=bet62_platform
DATABASE_URL=postgresql://bet62:Bet62!StrongPass2026@localhost:5432/bet62_platform?schema=public

# ============ REDIS ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Bet62RedisPass!2026
REDIS_URL=redis://:Bet62RedisPass!2026@localhost:6379

# ============ JWT / AUTH ============
JWT_ACCESS_SECRET=replace_this_with_strong_jwt_access_secret_min_32_chars_xxxxxx
JWT_REFRESH_SECRET=replace_this_with_strong_jwt_refresh_secret_min_32_chars_yyyyy
# Used by bets-service and odds-service; set it to the same value as JWT_ACCESS_SECRET
JWT_SECRET=replace_this_with_strong_jwt_access_secret_min_32_chars_xxxxxx
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ISSUER=bet62-platform
BCRYPT_ROUNDS=12
ARGON2_MEMORY=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=4

# ============ MICROSERVICES PORTS ============
PORT_API_GATEWAY=3000
PORT_AUTH_SERVICE=3001
PORT_USER_SERVICE=3002
PORT_KYC_SERVICE=3003
PORT_WALLET_SERVICE=3004
PORT_ODDS_SERVICE=3005
PORT_BETS_SERVICE=3006
PORT_BONUS_SERVICE=3007
PORT_CASINO_SERVICE=3008
PORT_NOTIFICATIONS_SERVICE=3009
PORT_ADMIN_SERVICE=3010
PORT_WEB=3080

# ============ STRIPE (PAYMENTS) ============
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=eur

# ============ DIDIT (KYC) ============
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=replace_with_didit_api_key
DIDIT_WEBHOOK_SECRET=replace_with_didit_webhook_destination_secret
DIDIT_WORKFLOW_ID=replace_with_default_workflow_id
DIDIT_WORKFLOW_ID_L1=replace_with_level1_workflow_id
DIDIT_WORKFLOW_ID_L2=replace_with_level2_workflow_id
# Nightly AML re-screening of already-verified users (kyc-service cron, 02:00 UTC)
AML_MONITORING_ENABLED=true

# ============ ODDS PROVIDER (SPORTS CORE) ============
# ---- GOAL API (Futebol Source of Truth - dados, stats, settlement) ----
# Documentacao: https://goal-api.com/documentation
# Registo/Dashboard: https://goal-api.com
# Planos: FREE (limitado) / BASIC / PRO / ENTERPRISE (WS concorrente 5/20/1000)
GOAL_API_KEY=coloca_aqui_key_goal_api_dashboard
GOAL_API_BASE_URL=https://api.goal-api.com/v1
GOAL_API_WS_URL=wss://api.goal-api.com/ws
# ---- PropLine (Odds Source of Truth - futebol + todos outros esportes) ----
# Documentacao: https://prop-line.com/docs | LLM spec completa: https://prop-line.com/llms-full.txt
# 20+ bookmakers, 56 esportes, push books ~1-2s latencia, stats ~90s
PROPLINE_API_KEY=coloca_aqui_key_propline_dashboard
PROPLINE_API_BASE_URL=https://api.prop-line.com/v1
PROPLINE_WS_URL=wss://ws.prop-line.com/v1/stream
# ---- GOALDIR BSD (Provedor REAL LEGACY) ----
# Registo: https://goaldir.com/register/
# Dashboard: https://goaldir.com/dashboard/
# Planos: FREE=Futebol REST | Addon Sports 5€=+Ténis/Basquet/Hóquei/CS2 | Addon WS 3€=Live Odds push
ODDS_PROVIDER_NAME=goaldir
ODDS_PROVIDER_BASE_URL=https://sports.bzzoiro.com
ODDS_PROVIDER_API_KEY=coloca_a_chave_do_dashboard_goaldir_aqui
ODDS_PROVIDER_TIMEOUT_MS=15000
GOALDIR_WS_ENABLED=true
# ---- GOALDIR BSD END ----
# Exemplo alternativo de provider customizado.
# Mantenha comentado se estiver a usar GOALDIR / BZZ.
# ODDS_PROVIDER_TYPE=mock
# ODDS_PROVIDER_NAME=CUSTOM_PROVIDER
# ODDS_PROVIDER_API_KEY=replace_api_key
# ODDS_PROVIDER_BASE_URL=https://api.odds-provider.example.com
ODDS_PROVIDER_RATE_LIMIT_PER_MIN=300
ODDS_SYNC_PREMATCH_INTERVAL_SEC=300
ODDS_SYNC_LIVE_INTERVAL_SEC=15
ODDS_SLIPPAGE_MAX_PERCENT=5

# ============ SMTP (EMAILS) ============
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=replace_sendgrid_api_key
SMTP_FROM_EMAIL=no-reply@bet62.pt
SMTP_FROM_NAME="BET62 Apostas"

# ============ WEB PUSH (VAPID) ============
VAPID_PUBLIC_KEY=replace_vapid_public_key_base64
VAPID_PRIVATE_KEY=replace_vapid_private_key_base64
VAPID_CONTACT_EMAIL=admin@bet62.pt

# ============ ADMIN DEFAULT ============
ADMIN_DEFAULT_EMAIL=admin@bet62.pt
ADMIN_DEFAULT_PASSWORD=Bet62Admin!2026
ADMIN_DEFAULT_SUPER_EMAIL=superadmin@bet62.pt
ADMIN_DEFAULT_SUPER_PASSWORD=Bet62Super!2026

# ============ SECURITY / MISC ============
CORS_ORIGIN=http://localhost:3080,http://localhost:3000
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_API_WINDOW_SEC=60
RATE_LIMIT_API_MAX=100
REALITY_CHECK_INTERVAL_MIN=60
SESSION_INACTIVITY_TIMEOUT_SEC=1800
